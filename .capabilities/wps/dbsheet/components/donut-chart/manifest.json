{
  "id": "donut-chart",
  "name": "圆环图",
  "description": "按扇区字段聚合多维表记录并渲染圆环图",
  "propsSchema": {
    "type": "object",
    "properties": {
      "fileId": {
        "type": "string",
        "title": "多维表文件 ID",
        "description": "kdocs 文件 ID 或链接中的 fileId"
      },
      "tableId": {
        "type": "string",
        "title": "数据表",
        "x-resource": "list-tables",
        "x-resource-params": {
          "fileId": { "$ref": "fileId" }
        }
      },
      "dimension": {
        "type": "string",
        "title": "扇区分组",
        "x-resource": "list-fields",
        "x-resource-params": {
          "fileId": { "$ref": "fileId" },
          "tableId": { "$ref": "tableId" }
        }
      },
      "statisticMode": {
        "type": "string",
        "title": "扇区数值",
        "enum": ["count", "field"],
        "enumNames": ["记录总数", "指定字段"],
        "default": "count"
      },
      "statisticFieldId": {
        "type": "string",
        "title": "统计字段",
        "x-resource": "list-fields",
        "x-resource-params": {
          "fileId": { "$ref": "fileId" },
          "tableId": { "$ref": "tableId" }
        }
      },
      "sortBy": {
        "type": "string",
        "title": "排序依据",
        "enum": ["x", "y"],
        "enumNames": ["扇区名称", "扇区数值"],
        "default": "x"
      },
      "sortOrder": {
        "type": "string",
        "title": "排序方式",
        "enum": ["asc", "desc"],
        "enumNames": ["正序", "倒序"],
        "default": "asc"
      }
    },
    "required": ["fileId", "tableId", "dimension"]
  },
  "x-customization": {
    "overrideable": ["components/donut-chart/render.js"],
    "prefer_props": [
      "fileId",
      "tableId",
      "dimension",
      "statisticMode",
      "statisticFieldId",
      "sortBy",
      "sortOrder"
    ]
  }
}
